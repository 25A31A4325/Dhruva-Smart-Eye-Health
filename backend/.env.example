# ===================================================================
# Dhruva Backend Environment Configuration (Production & Development)
# ===================================================================

# Environment mode: "development" | "production"
ENVIRONMENT=development

# Server Port (Render injects $PORT automatically in production)
PORT=8000

# Security / JWT Authentication
# IMPORTANT: Generate a strong 64-character random secret for production!
# e.g., generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-strong-random-hex-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production CORS Whitelist
# In production on Render, set this to your deployed Vercel frontend URL:
# FRONTEND_URL=https://dhruva-eye-health.vercel.app
FRONTEND_URL=

# -------------------------------------------------------------------
# Google Cloud / Firebase Firestore Configuration
# -------------------------------------------------------------------
# Option A (Recommended for Render): Paste the contents of your serviceAccountKey.json as a string:
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# Option B (Render Secret File): Mount your serviceAccountKey.json as a secret file:
# FIREBASE_CREDENTIALS_PATH=/etc/secrets/serviceAccountKey.json

FIREBASE_PROJECT_ID=dhruva-eye-health

# In-memory Mock Firestore:
# In development/testing, set to "true" to run offline without GCP credentials.
# In production, this must remain "false".
USE_MOCK_FIRESTORE=false
